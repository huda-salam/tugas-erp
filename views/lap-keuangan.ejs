<%- include('partials/atas') %>

<form method="get" action="/laporan/keuangan" class="card no-print" style="padding:12px">
  <div class="baris" style="align-items:flex-end">
    <div class="grup"><label for="dari">Dari</label>
      <input type="date" id="dari" name="dari" class="kontrol" value="<%= dari %>"></div>
    <div class="grup"><label for="sampai">Sampai</label>
      <input type="date" id="sampai" name="sampai" class="kontrol" value="<%= sampai %>"></div>
    <div class="grup" style="max-width:120px"><button class="btn btn-primer btn-blok">Tampilkan</button></div>
    <div class="grup" style="max-width:120px"><button type="button" class="btn btn-abu btn-blok" onclick="print()">Cetak</button></div>
  </div>
</form>

<div class="card">
  <div class="report-header">
    <h1><%= namaUsaha %></h1>
    <h2 id="report-title-text">Laporan Laba Rugi</h2>
    <p>Periode <%= tglID(l.dari) %><%= l.dari !== l.sampai ? ' s.d. ' + tglID(l.sampai) : '' %></p>
  </div>

  <div class="tabs-nav no-print">
    <button type="button" class="tab-btn active" onclick="switchTab('laba-rugi', this)">1. Laba Rugi</button>
    <button type="button" class="tab-btn"        onclick="switchTab('neraca', this)">2. Neraca</button>
  </div>

  <!-- ============ LABA RUGI ============ -->
  <div id="laba-rugi" class="report-section active">
    <div class="tabel-scroll"><table class="akun">
      <thead><tr>
        <th style="width:76px">Kode</th>
        <th>Keterangan Unsur Laporan</th>
        <th class="ka" style="width:130px">Nilai (IDR)</th>
      </tr></thead>
      <tbody>
        <tr class="level-1"><td class="kode">4-0000</td><td>PENDAPATAN USAHA</td><td></td></tr>
        <tr class="level-3"><td class="kode">4-1100</td><td>Penjualan Produk (bruto)</td>
            <td class="ka"><%= rupiah(l.labaRugi.bruto) %></td></tr>
        <% if (l.labaRugi.komisi > 0) { %>
        <tr class="level-3"><td class="kode">4-1200</td><td>Potongan Komisi Platform (GrabFood)</td>
            <td class="ka t-merah">(<%= rupiah(l.labaRugi.komisi) %>)</td></tr>
        <% } %>
        <tr class="subtotal"><td></td><td>PENDAPATAN BERSIH</td>
            <td class="ka"><%= rupiah(l.labaRugi.netto) %></td></tr>

        <tr class="level-1"><td class="kode">5-0000</td><td>BEBAN POKOK PENJUALAN (HPP)</td><td></td></tr>
        <tr class="level-3"><td class="kode">5-1100</td><td>HPP Produk Terjual</td>
            <td class="ka t-merah">(<%= rupiah(l.labaRugi.hpp) %>)</td></tr>
        <tr class="subtotal"><td></td><td>LABA KOTOR</td>
            <td class="ka <%= l.labaRugi.labaKotor >= 0 ? 't-hijau':'t-merah' %>">
              <%= rupiah(l.labaRugi.labaKotor) %></td></tr>

        <tr class="level-1"><td class="kode">6-0000</td><td>BEBAN OPERASIONAL &amp; ADMINISTRASI</td><td></td></tr>
        <% if (!l.labaRugi.bebanRows.length) { %>
          <tr class="level-3"><td class="kode">6-1100</td><td class="t-lembut"><em>tidak ada beban tercatat</em></td>
              <td class="ka t-lembut">Rp 0</td></tr>
        <% } %>
        <% l.labaRugi.bebanRows.forEach((b, i) => { %>
          <tr class="level-3"><td class="kode">6-<%= String(1100 + i*100) %></td>
              <td>Beban <%= b.kategori %></td>
              <td class="ka t-merah">(<%= rupiah(b.jumlah) %>)</td></tr>
        <% }) %>
        <tr class="subtotal"><td></td><td>TOTAL BEBAN OPERASIONAL</td>
            <td class="ka t-merah">(<%= rupiah(l.labaRugi.totalBeban) %>)</td></tr>

        <tr class="level-1"><td class="kode">7-0000</td><td>KERUGIAN &amp; PENYESUAIAN PERSEDIAAN</td><td></td></tr>
        <tr class="level-3"><td class="kode">7-1100</td><td>Kerugian Produk Terbuang (waste)</td>
            <td class="ka <%= l.labaRugi.penyesuaian.waste < 0 ? 't-merah':'t-lembut' %>">
              <%= l.labaRugi.penyesuaian.waste < 0
                    ? '(' + rupiah(-l.labaRugi.penyesuaian.waste) + ')' : 'Rp 0' %></td></tr>
        <tr class="level-3"><td class="kode">7-1200</td><td>Selisih Stock Opname</td>
            <td class="ka <%= l.labaRugi.penyesuaian.opname < 0 ? 't-merah' : (l.labaRugi.penyesuaian.opname > 0 ? 't-hijau':'t-lembut') %>">
              <%= l.labaRugi.penyesuaian.opname < 0
                    ? '(' + rupiah(-l.labaRugi.penyesuaian.opname) + ')'
                    : rupiah(l.labaRugi.penyesuaian.opname) %></td></tr>

        <tr class="total-acc-row"><td></td><td>LABA BERSIH PERIODE BERJALAN</td>
            <td class="ka" style="font-size:15px">
              <span class="<%= l.labaRugi.labaBersih >= 0 ? 't-hijau':'t-merah' %>">
                <%= rupiah(l.labaRugi.labaBersih) %></span></td></tr>
      </tbody>
    </table></div>
  </div>

  <!-- ============ NERACA ============ -->
  <div id="neraca" class="report-section">
    <div class="tabel-scroll"><table class="akun">
      <thead><tr>
        <th style="width:76px">Kode</th>
        <th>Posisi Aset (Aktiva)</th>
        <th class="ka" style="width:130px">Nilai (IDR)</th>
      </tr></thead>
      <tbody>
        <tr class="level-1"><td class="kode">1-0000</td><td>ASET LANCAR</td><td></td></tr>
        <tr class="level-3"><td class="kode">1-1100</td><td>Kas dan Setara Kas</td>
            <td class="ka"><%= rupiah(l.neraca.kas) %></td></tr>
        <tr class="level-3"><td class="kode">1-1150</td><td>Piutang GrabFood (belum cair)</td>
            <td class="ka"><%= rupiah(l.neraca.piutang) %></td></tr>
        <tr class="level-3"><td class="kode">1-1200</td><td>Persediaan Bahan Baku</td>
            <td class="ka"><%= rupiah(l.neraca.persBahan) %></td></tr>
        <tr class="level-3"><td class="kode">1-1300</td><td>Persediaan Produk Jadi</td>
            <td class="ka"><%= rupiah(l.neraca.persProduk) %></td></tr>
        <tr class="total-acc-row"><td></td><td>TOTAL ASET (AKTIVA)</td>
            <td class="ka"><%= rupiah(l.neraca.totalAset) %></td></tr>
      </tbody>
    </table></div>

    <div class="tabel-scroll" style="margin-top:20px"><table class="akun">
      <thead><tr>
        <th style="width:76px">Kode</th>
        <th>Liabilitas &amp; Ekuitas (Pasiva)</th>
        <th class="ka" style="width:130px">Nilai (IDR)</th>
      </tr></thead>
      <tbody>
        <tr class="level-1"><td class="kode">2-0000</td><td>LIABILITAS (UTANG)</td><td></td></tr>
        <tr class="level-3"><td class="kode">2-1100</td><td>Utang Usaha / Pemasok Bahan</td>
            <td class="ka"><%= rupiah(l.neraca.utang) %></td></tr>

        <tr class="level-1"><td class="kode">3-0000</td><td>EKUITAS (MODAL)</td><td></td></tr>
        <tr class="level-3"><td class="kode">3-1100</td><td>Modal Pemilik Disetor</td>
            <td class="ka"><%= rupiah(l.neraca.modal) %></td></tr>
        <tr class="level-3"><td class="kode">3-1200</td><td>Prive / Pengambilan Pemilik</td>
            <td class="ka <%= l.neraca.prive > 0 ? 't-merah':'t-lembut' %>">
              <%= l.neraca.prive > 0 ? '(' + rupiah(l.neraca.prive) + ')' : 'Rp 0' %></td></tr>
        <tr class="level-3"><td class="kode">3-1300</td><td>Laba Ditahan (akumulasi)</td>
            <td class="ka t-biru"><%= rupiah(l.neraca.labaDitahan) %></td></tr>
        <tr class="subtotal"><td></td><td>TOTAL EKUITAS</td>
            <td class="ka"><%= rupiah(l.neraca.ekuitas) %></td></tr>

        <tr class="total-acc-row"><td></td><td>TOTAL LIABILITAS DAN EKUITAS (PASIVA)</td>
            <td class="ka"><%= rupiah(l.neraca.totalPasiva) %></td></tr>
      </tbody>
    </table></div>

    <p class="catatan-sak">
      * Status Validasi:
      <strong class="<%= l.neraca.seimbang ? 't-hijau':'t-merah' %>">
        <%= l.neraca.seimbang ? 'BALANCE / SEIMBANG' : 'TIDAK SEIMBANG' %>
      </strong>
      <% if (!l.neraca.seimbang) { %>
        (selisih <%= rupiah(l.neraca.totalAset - l.neraca.totalPasiva) %>)
      <% } %>
    </p>
  </div>

  <p class="petunjuk" style="margin-top:16px">Seluruh angka dihitung dari transaksi yang tercatat —
     tidak ada nilai yang diketik manual. Persediaan dinilai dengan harga rata-rata bergerak.
     Prive tidak mengurangi laba karena bukan beban usaha.</p>
</div>

<script>
function switchTab(id, el) {
  document.querySelectorAll('.report-section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.tabs-nav .tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  el.classList.add('active');
  document.getElementById('report-title-text').innerText =
    id === 'laba-rugi' ? 'Laporan Laba Rugi' : 'Laporan Posisi Keuangan (Neraca)';
}
</script>

<%- include('partials/bawah') %>
